{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "spring-boot:run",
            "type": "shell",
            "command": "mvn",
            "args": ["spring-boot:run"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "spring-boot",
                "pattern": {
                    "regexp": "^(.*):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Scanning for projects.*$",
                    "endsPattern": "^.*Started OracleMcpServerApplication.*$"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "mvn clean install",
            "type": "shell",
            "command": "mvn",
            "args": ["clean", "install"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "mvn package",
            "type": "shell",
            "command": "mvn",
            "args": ["package", "-DskipTests"],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
