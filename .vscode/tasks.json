{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "quarkus:dev",
            "type": "shell",
            "command": "mvn",
            "args": ["quarkus:dev"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "quarkus",
                "pattern": {
                    "regexp": "^(.*):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Scanning for projects.*$",
                    "endsPattern": "^.*Quarkus.*started in.*$"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "mvn clean install",
            "type": "shell",
            "command": "mvn",
            "args": ["clean", "install"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "mvn exec:java (CLI)",
            "type": "shell",
            "command": "mvn",
            "args": ["exec:java"],
            "group": "test",
            "problemMatcher": []
        }
    ]
}
